# Django Backend Environment Variables
# Copy this file to .env and fill in real values.

DJANGO_DEBUG=False
DJANGO_SECRET_KEY=replace-with-a-real-secret-key
DJANGO_ALLOWED_HOSTS=your-api-domain.com

# Frontend
FRONTEND_ORIGINS=https://your-frontend-domain.com
FRONTEND_BASE_URL=https://your-frontend-domain.com

# Database (PostgreSQL required for production)
DATABASE_URL=postgresql://user:password@host:5432/calmcampus

# Cookie settings (use None for cross-origin cookie auth)
AUTH_COOKIE_SAMESITE=None
SESSION_COOKIE_SAMESITE=None

# Email (SMTP)
DEFAULT_FROM_EMAIL=noreply@your-domain.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# Security headers (production)
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True
